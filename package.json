{
  "name": "fontforge-glyph-preview",
  "displayName": "FontForge Glyph Preview",
  "description": "Preview glyph images contained in Spline Font Database files (*.sdf, *.glyph) used by FontForge",
  "publisher": "miraprobemv",
  "icon": "images/icon.png",
  "homepage": "https://github.com/miraprobemv/vscode-fontforge-glyph-preview",
  "repository": {
    "type": "git",
    "url": "https://github.com/miraprobemv/vscode-fontforge-glyph-preview.git"
  },
  "bugs": {
    "url": "https://github.com/miraprobemv/vscode-fontforge-glyph-preview/issues"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "fontforge",
    "font"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sfd",
        "aliases": [
          "Spline Font Database",
          "sfd"
        ],
        "extensions": [
          ".sfd",
          ".glyph"
        ],
        "filenames": [
          "font.props"
        ]
      }
    ],
    "commands": [
      {
        "command": "fontforge-glyph-preview.openPreview",
        "category": "FontForge Glyph Preview",
        "title": "Open Preview",
        "icon": "$(preview)"
      },
      {
        "command": "fontforge-glyph-preview.openPreviewToSide",
        "category": "FontForge Glyph Preview",
        "title": "Open Preview to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "fontforge-glyph-preview.openPreview",
          "when": "editorLangId == sfd",
          "group": "navigation"
        },
        {
          "command": "fontforge-glyph-preview.openPreviewToSide",
          "when": "editorLangId == sfd",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "fontforge-glyph-preview.openPreview",
          "when": "resourceLangId == sfd",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "FontForge Glyph Preview",
      "properties": {
        "fontforge-glyph-preview.preview.previewPanelMode": {
          "type": "string",
          "default": "single",
          "enum": [
            "single",
            "multiple"
          ],
          "enumDescriptions": [
            "Always show a single preview panel. When the active text editor changes, the preview panel updates to display the glyph for that editor.",
            "Create a new preview panel each time a preview is opened. Each preview panel is associated with the document it was opened for."
          ],
          "description": "Configure how the preview panel is displayed."
        },
        "fontforge-glyph-preview.preview.setting.glyphSelectionMode": {
          "type": "string",
          "default": "table",
          "enum": [
            "table",
            "list"
          ],
          "enumDescriptions": [
            "Select a glyph from a table of previews sorted by character code.",
            "Select a glyph from a list of glyph names."
          ],
          "description": "Configure how the preview panel is displayed."
        },
        "fontforge-glyph-preview.preview.default.view.displayType": {
          "type": "string",
          "default": "metrics",
          "enum": [
            "metrics",
            "preview"
          ],
          "enumDescriptions": [
            "Display anchor points, handles, and other related details.",
            "Display the glyph's preview image."
          ],
          "description": "Configure how glyphs are displayed when the preview is initially shown."
        },
        "fontforge-glyph-preview.preview.default.view.curvatureCombs": {
          "type": "boolean",
          "default": "false",
          "description": "Display curvature combs when the preview is initially shown."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.103.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-web": "^0.0.72",
    "assert": "^2.1.0",
    "eslint": "^9.32.0",
    "mocha": "^11.7.1",
    "process": "^0.11.10",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
